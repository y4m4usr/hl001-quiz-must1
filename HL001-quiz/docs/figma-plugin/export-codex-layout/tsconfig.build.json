{
  "compilerOptions": {
    "target": "ES5",
    "module": "none",
    "allowJs": true,
    "outFile": "build/code.js",
    "downlevelIteration": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES5", "ES2015.Promise", "ES2015.Iterable"]
  },
  "include": ["code.js"],
  "exclude": ["node_modules"]
}
